{
  "name": "@rungent/sdk",
  "version": "0.3.7",
  "description": "Headless TypeScript SDK for Rungent sessions, runs, interactions, and ACS",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://rungent.github.io",
  "repository": {
    "type": "git",
    "url": "https://acahti.saidc.ai/saidc/rungent.git",
    "directory": "packages/sdk"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.5.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
